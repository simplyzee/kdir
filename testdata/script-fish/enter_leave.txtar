# fish: enter, nested, leave, with KUBECONFIG unset and as a multi-file list.

exec kctx stamp $HOME/.kube/config $WORK/multi-a.yaml $WORK/multi-b.yaml
cp stdout stamp-before
exec fish --no-config scenario.fish
cmp stdout want
cmp stderr want-stderr
exec kctx stamp $HOME/.kube/config $WORK/multi-a.yaml $WORK/multi-b.yaml
cmp stdout stamp-before

-- home/src/payments/.kubectx --
context: staging-eu
namespace: payments
-- home/proj/.kubectx --
context: beta
namespace: web
-- scenario.fish --
source $WORK/lib.fish
mkdir -p $HOME/src/payments/svc/api
kdir allow $HOME/src/payments
kdir allow $HOME/proj 2>/dev/null
check start
to $HOME/src/payments
check payments
set -l v (kdirvars); echo "vars:[$v]"
test "$KUBECONFIG" = "$KDIR_OVERLAY:$HOME/.kube/config"; and echo "overlay in front"
echo "short="(kdir status --short)
to $HOME/src/payments/svc/api
check nested
to $HOME
check home
set -q KUBECONFIG; and echo "KUBECONFIG still set"; or echo "KUBECONFIG unset"
set -l v (kdirvars); echo "vars:[$v]"

set -gx KUBECONFIG "$WORK/multi-a.yaml:$WORK/multi-b.yaml"
check multi-before
to $HOME/proj
check multi-in
to $HOME
test "$KUBECONFIG" = "$WORK/multi-a.yaml:$WORK/multi-b.yaml"; and echo "multi restored"
echo "overlays: "(ls $WORK/run/kdir | grep -c .)
-- want --
start: prod-eu/payments
payments: staging-eu/payments
vars:[KDIR_CONTEXT KDIR_NAMESPACE KDIR_ORIG_KUBECONFIG KDIR_ORIG_KUBECONFIG_SET KDIR_OVERLAY KDIR_ROOT KDIR_STATE]
overlay in front
short=staging-eu:payments
nested: staging-eu/payments
home: prod-eu/payments
KUBECONFIG unset
vars:[]
multi-before: alpha/alpha-ns
multi-in: beta/web
multi restored
overlays: 0
-- want-stderr --
kdir: allowed ~/src/payments/.kubectx
