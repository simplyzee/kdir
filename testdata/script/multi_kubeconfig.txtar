# An original multi-file KUBECONFIG, and one set to the empty string, are
# restored exactly; the real files are never written.

exec kctx stamp $WORK/multi-a.yaml $WORK/multi-b.yaml
cp stdout stamp-before
exec $SHELLBIN $SHELLFLAG scenario.sh
cmp stdout want
exec kctx stamp $WORK/multi-a.yaml $WORK/multi-b.yaml
cmp stdout stamp-before

-- home/proj/.kubectx --
context: beta
namespace: web
-- scenario.sh --
. "$WORK/lib.sh"
kdir allow "$HOME/proj" 2>/dev/null
orig="$WORK/multi-a.yaml:$WORK/multi-b.yaml"
export KUBECONFIG="$orig"
prompt
check before
to "$HOME/proj"
check in
[ "$KUBECONFIG" = "$KDIR_OVERLAY:$orig" ] && echo "overlay in front of the original list"
[ "$KDIR_ORIG_KUBECONFIG" = "$orig" ] && [ "$KDIR_ORIG_KUBECONFIG_SET" = 1 ] && echo "original saved"
to "$HOME"
check after
[ "$KUBECONFIG" = "$orig" ] && echo "restored exactly"

export KUBECONFIG=
to "$HOME/proj"
check empty-in
to "$HOME"
echo "empty restored: set=${KUBECONFIG+yes} value=[$KUBECONFIG]"
-- want --
before: alpha/alpha-ns
in: beta/web
overlay in front of the original list
original saved
after: alpha/alpha-ns
restored exactly
empty-in: ERROR
empty restored: set=yes value=[]
